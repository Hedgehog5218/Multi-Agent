998765587806702, "cx": 844.5, "cy": 1003.5, "x": 802.0, "y": 988.0, "w": 85.0, "h": 31.0}, {"text": "0.9215(↑28.8%)", "box": [[978.0, 988.0], [1166.0, 988.0], [1166.0, 1021.0], [978.0, 1021.0]], "score": 0.9996146985462734, "cx": 1072.0, "cy": 1004.5, "x": 978.0, "y": 988.0, "w": 188.0, "h": 33.0}], "5.png|218031|1786437092": [{"text": "基于阿克曼底盘的无人车路径规划与跟踪控制研究", "box": [[33.0, 5.0], [530.0, 6.0], [530.0, 26.0], [33.0, 26.0]], "score": 0.9984199106693268, "cx": 281.5, "cy": 15.75, "x": 33.0, "y": 5.0, "w": 497.0, "h": 21.0}, {"text": "摘要：伴随着人工智能与无人驾驶技术的快速发展，无人车在智慧物流、城市交通等", "box": [[8.0, 68.0], [555.0, 68.0], [555.0, 82.0], [8.0, 82.0]], "score": 0.9944863174412701, "cx": 281.5, "cy": 75.0, "x": 8.0, "y": 68.0, "w": 547.0, "h": 14.0}, {"text": "领域拥有广阔的应用前景，无人驾驶技术已经为当前研究的热点。然而，在实际应用", "box": [[9.0, 95.0], [556.0, 95.0], [556.0, 110.0], [9.0, 110.0]], "score": 0.9986562761100563, "cx": 282.5, "cy": 102.5, "x": 9.0, "y": 95.0, "w": 547.0, "h": 15.0}, {"text": "中，路径规划效率低下和路径跟踪精度不足等问题严重制约了无人驾驶技术的进一", "box": [[8.0, 123.0], [557.0, 123.0], [557.0, 138.0], [8.0, 138.0]], "score": 0.992578418718444, "cx": 282.5, "cy": 130.5, "x": 8.0, "y": 123.0, "w": 549.0, "h": 15.0}, {"text": "步发展。特别是在复杂的道路环境下，如何实现高效、精确的路径规划与跟踪控制仍", "box": [[8.0, 151.0], [555.0, 151.0], [555.0, 166.0], [8.0, 166.0]], "score": 0.998793993447278, "cx": 281.5, "cy": 158.5, "x": 8.0, "y": 151.0, "w": 547.0, "h": 15.0}, {"text": "然是函待解决的关键技术难题。本文以阿克曼底盘的无人车作为研究对象，针对上述", "box": [[8.0, 179.0], [556.0, 179.0], [556.0, 193.0], [8.0, 193.0]], "score": 0.992604141299789, "cx": 282.0, "cy": 186.0, "x": 8.0, "y": 179.0, "w": 548.0, "h": 14.0}, {"text": "挑战开展深入研究。", "box": [[8.0, 206.0], [135.0, 206.0], [135.0, 221.0], [8.0, 221.0]], "score": 0.9945696261194017, "cx": 71.5, "cy": 213.5, "x": 8.0, "y": 206.0, "w": 127.0, "h": 15.0}, {"text": "参考文献", "box": [[231.0, 227.0], [321.0, 227.0], [321.0, 250.0], [231.0, 250.0]], "score": 0.9999471008777618, "cx": 276.0, "cy": 238.5, "x": 231.0, "y": 227.0, "w": 90.0, "h": 23.0}, {